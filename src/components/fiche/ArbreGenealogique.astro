---
// Arbre généalogique d'un courant, généré depuis data/relations.json.
import { getFamilles } from '../../lib/data';
import type { LiensCourant } from '../../lib/courants';
import type { Courant } from '../../lib/schemas';
import { lien } from '../../lib/site';

interface Props {
  courant: Courant;
  liens: LiensCourant;
  courants: Map<string, Courant>;
}

const { courant, liens, courants } = Astro.props;
const couleurs = new Map(getFamilles().map((f) => [f.id, f.couleur]));

interface Groupe {
  titre: string;
  ids: string[];
  pointille?: boolean;
}

const amont: Groupe[] = [
  { titre: 'Dérive de', ids: liens.deriveDe },
  { titre: 'Synthèse avec', ids: liens.syntheseAvec, pointille: true },
  { titre: 'Rupture avec', ids: liens.ruptureAvec },
].filter((g) => g.ids.length > 0);

const aval: Groupe[] = [
  { titre: 'Descendants', ids: liens.descendants },
  { titre: 'En dialogue avec', ids: courant.enDialogueAvec, pointille: true },
  { titre: 'Rompent avec lui', ids: liens.rompentAvecLui },
  { titre: 'En opposition avec', ids: liens.oppositions },
].filter((g) => g.ids.length > 0);

const pilule = (id: string) => {
  const c = courants.get(id);
  return { id, nom: c?.nom ?? id, couleur: couleurs.get(c?.famille ?? '') ?? 'var(--c-bord-2)' };
};
---

<section class="arbre" aria-labelledby="t-arbre">
  <div class="arbre__entete">
    <h2 id="t-arbre">Arbre généalogique</h2>
    <a href={lien(`genealogie/?courant=${courant.id}`)}>Voir dans la frise complète</a>
  </div>
  {
    amont.length + aval.length === 0 ? (
      <p class="arbre__vide">Aucune relation recensée pour ce courant.</p>
    ) : (
      <div class="arbre__cadre">
        {amont.length > 0 && (
          <>
            <div class="arbre__colonne">
              {amont.map((g) => (
                <>
                  <p class="arbre__titre">{g.titre}</p>
                  <ul>
                    {g.ids.map(pilule).map((p) => (
                      <li>
                        <a
                          class:list={['arbre__pilule', { 'arbre__pilule--pointille': g.pointille }]}
                          style={`border-color: ${p.couleur}`}
                          href={lien(`courants/${p.id}/`)}
                        >
                          {p.nom}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </div>
            <svg class="arbre__fleche" width="48" height="20" viewBox="0 0 48 20" aria-hidden="true">
              <path d="M2 10 H42 M34 3 L42 10 L34 17" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </>
        )}
        <span class="arbre__courant">{courant.nom}</span>
        {aval.length > 0 && (
          <>
            <svg class="arbre__fleche" width="48" height="20" viewBox="0 0 48 20" aria-hidden="true">
              <path d="M2 10 H44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
            </svg>
            <div class="arbre__colonne">
              {aval.map((g) => (
                <>
                  <p class="arbre__titre">{g.titre}</p>
                  <ul>
                    {g.ids.map(pilule).map((p) => (
                      <li>
                        <a
                          class:list={['arbre__pilule', { 'arbre__pilule--pointille': g.pointille }]}
                          style={`border-color: ${p.couleur}`}
                          href={lien(`courants/${p.id}/`)}
                        >
                          {p.nom}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </div>
          </>
        )}
      </div>
    )
  }
</section>

<style>
  .arbre {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .arbre__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .arbre__entete a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
  }

  .arbre__cadre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding: 24px;
    border: 1px solid var(--c-bord);
    border-radius: var(--r-m);
    background: var(--c-fond-zebre);
  }

  .arbre__colonne {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .arbre__colonne ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 6px;
    padding: 0;
    list-style: none;
  }

  .arbre__titre {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-texte-3);
  }

  .arbre__pilule {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 4px 12px;
    border: 1.5px solid;
    border-radius: var(--r-pill);
    background: var(--c-fond);
    color: var(--c-encre);
    font-size: 14px;
    text-decoration: none;
  }

  .arbre__pilule:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .arbre__pilule--pointille {
    border-style: dashed;
  }

  .arbre__fleche {
    color: var(--c-texte-3);
    flex: none;
  }

  .arbre__courant {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
  }

  .arbre__vide {
    color: var(--c-texte-2);
  }

  @media (max-width: 640px) {
    .arbre__cadre {
      flex-direction: column;
      align-items: flex-start;
    }

    .arbre__fleche {
      transform: rotate(90deg);
    }
  }
</style>
